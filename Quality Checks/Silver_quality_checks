/*
===============================================================================
Quality Checks: Silver Layer
===============================================================================
Script Purpose:
    This script performs quality checks to validate the integrity, consistency,
    and accuracy of the Silver Layer. These checks ensure:
    - Uniqueness of primary keys in the silver tables.
    - Referential integrity between related silver tables.
    - Consistency of the relationships used later to build the Gold Layer.

Usage Notes:
    - Run after loading the Silver Layer (EXEC silver.load_silver;).
    - Investigate and resolve any discrepancies found during the checks.
===============================================================================
*/

-- ====================================================================
-- Checking 'silver.crm_cust_info'
-- ====================================================================
-- Check for Uniqueness of Customer ID in silver.crm_cust_info
-- Expectation: No results
SELECT
    cust_id,
    COUNT(*) AS duplicate_count
FROM silver.crm_cust_info
GROUP BY cust_id
HAVING COUNT(*) > 1;

-- ====================================================================
-- Checking 'silver.crm_prd_info'
-- ====================================================================
-- Check for Uniqueness of Product ID in silver.crm_prd_info
-- (prd_key is NOT unique here because each product has several versions)
-- Expectation: No results
SELECT
    prd_id,
    COUNT(*) AS duplicate_count
FROM silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1;

-- Check that no product version ends before it starts
-- Expectation: No results
SELECT *
FROM silver.crm_prd_info
WHERE prd_end_dt < prd_strt_dt;

-- ====================================================================
-- Checking 'silver.erp_cust_az12'
-- ====================================================================
-- Check for Uniqueness of Customer ID in silver.erp_cust_az12
-- Expectation: No results
SELECT
    cid,
    COUNT(*) AS duplicate_count
FROM silver.erp_cust_az12
GROUP BY cid
HAVING COUNT(*) > 1;

-- ====================================================================
-- Checking 'silver.erp_loc_a101'
-- ====================================================================
-- Check for Uniqueness of Customer ID in silver.erp_loc_a101
-- Expectation: No results
SELECT
    cid,
    COUNT(*) AS duplicate_count
FROM silver.erp_loc_a101
GROUP BY cid
HAVING COUNT(*) > 1;

-- ====================================================================
-- Checking 'silver.erp_px_cat_g1v2'
-- ====================================================================
-- Check for Uniqueness of Category ID in silver.erp_px_cat_g1v2
-- Expectation: No results
SELECT
    id,
    COUNT(*) AS duplicate_count
FROM silver.erp_px_cat_g1v2
GROUP BY id
HAVING COUNT(*) > 1;

-- ====================================================================
-- Checking 'silver.crm_sales_details'
-- ====================================================================
-- Check the data model connectivity between sales and customer/product tables
-- Expectation: No results
SELECT *
FROM silver.crm_sales_details s
LEFT JOIN silver.crm_cust_info c
    ON c.cust_id = s.sls_cust_id
LEFT JOIN silver.crm_prd_info p
    ON p.prd_key = s.sls_prd_key
WHERE c.cust_id IS NULL OR p.prd_key IS NULL;

-- Check that products map to a category in the ERP category table
-- Expectation: No results
SELECT DISTINCT p.cat_id
FROM silver.crm_prd_info p
LEFT JOIN silver.erp_px_cat_g1v2 pc
    ON pc.id = p.cat_id
WHERE pc.id IS NULL;

-- Check that ERP customer and location records map to a CRM customer
-- Expectation: No results
SELECT a.cid
FROM silver.erp_cust_az12 a
LEFT JOIN silver.crm_cust_info c
    ON c.cst_key = a.cid
WHERE c.cst_key IS NULL;

SELECT l.cid
FROM silver.erp_loc_a101 l
LEFT JOIN silver.crm_cust_info c
    ON c.cst_key = l.cid
WHERE c.cst_key IS NULL;
